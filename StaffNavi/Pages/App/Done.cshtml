@page
@model StaffNavi.Pages.App.DoneModel
@{
    ViewData["Title"] = "申請完了";
    ViewData["Tab"] = "request";
    var r = Model.Item;
    var today = AdvanceService.TodayOf(Clock.Now);
    var approved = r.Status == AdvanceStatus.Approved;
}

<section class="m-done">
    <div class="m-check @(approved ? "" : "wait")">
        @if (approved)
        {
            <svg viewBox="0 0 52 52" aria-hidden="true"><circle cx="26" cy="26" r="24" /><path d="M15 27l7 7 15-16" /></svg>
        }
        else
        {
            @Icons.Svg("clock", 46)
        }
    </div>
    <h1>@(approved ? "申請を受け付けました" : "承認待ちです")</h1>
    <p>
        @if (approved)
        {
            @(r.ScheduledDate == today ? "本日中にお振込みします。" : $"{r.ScheduledDate.Month}月{r.ScheduledDate.Day}日（{Fmt.Weekday(r.ScheduledDate)}）にお振込みします。")
        }
        else
        {
            @:担当者が確認のうえ承認すると、お振込みの予定日をお知らせします。
        }
    </p>
</section>

<section class="m-card">
    <dl class="m-summary mb-0">
        <div><dt>申請額</dt><dd>¥@Fmt.Yen(r.Amount)</dd></div>
        <div><dt>振込手数料</dt><dd>−¥@Fmt.Yen(r.Amount - r.TransferAmount)</dd></div>
        <div class="total"><dt>お振込額</dt><dd>¥@Fmt.Yen(r.TransferAmount)</dd></div>
        <div><dt>状態</dt><dd><span class="pill @r.Status.Pill()">@r.Status.Label()@(r.AutoApproved ? "（自動承認）" : "")</span></dd></div>
        <div><dt>申請日時</dt><dd>@r.RequestedAt.ToString("M/d HH:mm")</dd></div>
    </dl>
</section>

<a class="m-btn" asp-page="/App/Index">ホームに戻る</a>
