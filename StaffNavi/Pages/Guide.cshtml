@page
@{
    ViewData["Title"] = "操作ガイド";
    ViewData["Nav"] = "guide";
    (string Icon, string Title, string Body, string Page, string Link)[] steps =
    [
        ("download", "サンプルCSVを用意する", $"CSV取込画面から「{DemoSeeder.SampleTimesheetFileName}」をダウンロードします。いただいた実データ（タイムシートA勤.csv など）と同じ形式の架空データです。", "/Import/Index", "CSV取込を開く"),
        ("upload", "タイムシートを取り込む", "受注（SSの勤務帯）ごとに出力したタイムシートを取り込みます。取込件数・エラー・要確認データ（打刻漏れ・休憩不足など）を確認して確定します。", "/Import/Index", "CSV取込を開く"),
        ("calendar", "勤務表で確認・補正する", "勤務表は受注ごとに、スタッフナビゲーターの勤務表（実績）と同じ列（所定・区分・出欠・始業・終業・基本・普通残・深夜…）で表示します。掛け持ちの重複や打刻漏れは赤色で表示され、根拠資料を確認して補正します（理由は必須）。", "/Timesheet/Index", "勤務表を開く"),
        ("history", "補正履歴を確認する", "補正前・補正後の差分、理由、補正者、日時を一覧で確認できます。誤った補正は取消できますが、記録は削除されません。", "/Corrections/Index", "補正履歴を開く"),
        ("database", "スタッフナビゲーターに戻す", "補正後の勤怠を、スタッフ×受注ごとに「勤怠データCSVファイル取込」形式で出力し、スタッフナビゲーターで給与計算します。", "/Output/Index", "提出資料出力を開く"),
        ("ledger", "給与計算書を取り込み、賃金台帳を作る", $"スタッフナビゲーターの給与計算書CSV（例：{DemoSeeder.SamplePayrollFileName}）を取り込むと、賃金台帳（先方のExcelと同じ様式・1年分）が全員分できあがります。", "/Ledger/Index", "賃金台帳を開く"),
        ("printer", "提出用資料を出力する", "勤務表（出勤簿）・賃金台帳・勤務実績集計表を、印刷またはPDFで出力します。補正箇所には※印を付けられます。", "/Output/Index", "提出資料出力を開く"),
    ];
}

<div class="page-head">
    <div>
        <h1 class="page-title">操作ガイド</h1>
        <div class="page-sub">デモ画面の基本的な操作の流れです</div>
    </div>
</div>

<div class="panel">
    <div class="panel-title"><h2>システム構成</h2></div>
    <partial name="_DataFlow" />
</div>

<div class="panel">
    <div class="panel-title"><h2>操作の流れ</h2></div>
    <div class="row g-3">
        @for (var i = 0; i < steps.Length; i++)
        {
            var step = steps[i];
            <div class="col-md-6 col-xl-4">
                <div class="tile h-100">
                    <span class="tile-head"><span class="pill pill-blue">STEP @(i + 1)</span> @Icons.Svg(step.Icon, 20, "blue") @step.Title</span>
                    <span class="small my-2">@step.Body</span>
                    <a class="small mt-auto" asp-page="@step.Page">@step.Link →</a>
                </div>
            </div>
        }
    </div>
</div>

<div class="note-box warn">
    @Icons.Svg("alert", 18)
    <div>本画面はお打ち合わせでのご確認用のデモです。画面構成・機能・計算方法は現時点の想定であり、実際の仕様はお打ち合わせでのご意見を踏まえて決定します。</div>
</div>
