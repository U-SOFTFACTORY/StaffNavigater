@page
@model StaffNavi.Pages.Ledger.IndexModel
@{
    ViewData["Title"] = "賃金台帳";
    ViewData["Nav"] = "ledger";
    var current = Model.Current;
}

<div class="page-head">
    <div>
        <h1 class="page-title">賃金台帳</h1>
        <div class="page-sub">補正後の勤務実績をもとに、スタッフナビゲーターと同じ様式（1年分・月別）で集計します</div>
    </div>
    @if (current != null)
    {
        <div class="d-flex gap-2 flex-wrap">
            <a class="btn btn-outline-secondary" asp-page-handler="Csv" asp-route-year="@Model.Year" asp-route-emp="@current.EmployeeNo">@Icons.Svg("download", 16) CSV出力（スタッフナビゲーター形式）</a>
            <a class="btn btn-primary" asp-page="/Output/Print" asp-route-type="ledger" asp-route-year="@Model.Year" asp-route-emp="@current.EmployeeNo" target="_blank">@Icons.Svg("printer", 16) 提出用PDF</a>
        </div>
    }
</div>

@if (Model.Years.Count == 0)
{
    <div class="panel">
        <p class="mb-3">勤怠データがまだ取り込まれていません。</p>
        <a class="btn btn-primary" asp-page="/Import/Index">@Icons.Svg("upload", 16) CSV取込へ</a>
    </div>
    return;
}

<div class="row g-3">
    <div class="col-lg-3">
        <div class="panel">
            <form method="get" class="mb-3">
                <label class="form-label small text-muted mb-1">対象年</label>
                <select class="form-select mb-2" name="year" onchange="this.form.submit()">
                    @foreach (var y in Model.Years)
                    {
                        <option value="@y" selected="@(y == Model.Year)">@(y)年</option>
                    }
                </select>
                <label class="form-label small text-muted mb-1">拠点</label>
                <select class="form-select" name="site" onchange="this.form.submit()">
                    <option value="">すべての拠点</option>
                    @foreach (var s in Model.Sites)
                    {
                        <option value="@s" selected="@(s == Model.Site)">@s</option>
                    }
                </select>
            </form>
            <div class="staff-list">
                @foreach (var s in Model.StaffList)
                {
                    <a class="staff-item @(s == current ? "active" : "")" asp-route-year="@Model.Year" asp-route-site="@Model.Site" asp-route-emp="@s.EmployeeNo">
                        <span>
                            <span class="name d-block">@s.Name</span>
                            <span class="meta">@s.EmployeeNo・@s.Site</span>
                        </span>
                    </a>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-9">
        @if (current != null)
        {
            var byMonth = Model.Columns.Where(c => c.Staff != null).ToDictionary(c => int.Parse(c.Month[5..]));
            var months = Enumerable.Range(1, 12).ToList();
            var staffMonths = byMonth.Values.Select(c => c.Staff!).ToList();
            <div class="panel">
                <div class="row g-2 small">
                    <div class="col-sm-6 col-xl-3"><span class="text-muted">スタッフ番号／スタッフ名</span><div class="fw-bold fs-6">@current.EmployeeNo　@current.Name</div></div>
                    <div class="col-sm-6 col-xl-3"><span class="text-muted">性別／生年月日</span><div class="fw-bold">@current.Gender ／ @(current.BirthDate?.ToString("yyyy/MM/dd") ?? "-")</div></div>
                    <div class="col-sm-6 col-xl-3"><span class="text-muted">税区分／入社日</span><div class="fw-bold">甲 ／ @current.HireDate.ToString("yyyy/MM/dd")</div></div>
                    <div class="col-sm-6 col-xl-3"><span class="text-muted">拠点／時給</span><div class="fw-bold">@current.Site ／ @Fmt.Yen(current.HourlyWage)円</div></div>
                </div>
            </div>
            <div class="panel">
                <div class="table-wrap">
                    <table class="table table-app table-bordered ledger-table">
                        <thead>
                            <tr>
                                <th style="min-width: 150px">@(Model.Year)年1月～@(Model.Year)年12月給与</th>
                                @foreach (var m in months)
                                {
                                    <th class="num">
                                        @if (byMonth.TryGetValue(m, out var col))
                                        {
                                            <a asp-page="/Timesheet/Index" asp-route-month="@col.Month" asp-route-emp="@current.EmployeeNo">@(m)月</a>
                                            @if (col.Staff!.Summary.CorrectionCount > 0)
                                            {
                                                <div><span class="pill pill-orange">補正@(col.Staff.Summary.CorrectionCount)</span></div>
                                            }
                                        }
                                        else
                                        {
                                            <text>@(m)月</text>
                                        }
                                    </th>
                                }
                                <th class="num">給与計</th>
                            </tr>
                            <tr class="ledger-sub">
                                <th class="fw-normal">支払日</th>
                                @foreach (var m in months)
                                {
                                    <td class="num">@(byMonth.TryGetValue(m, out var col) ? col.View.PayDate.ToString("M/d") : "")</td>
                                }
                                <td></td>
                            </tr>
                            <tr class="ledger-sub">
                                <th class="fw-normal">対象期間</th>
                                @foreach (var m in months)
                                {
                                    <td class="num text-nowrap">@(byMonth.TryGetValue(m, out var col) ? $"{col.View.FirstDay:M/d}～{col.View.LastDay:M/d}" : "")</td>
                                }
                                <td></td>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var previousGroup = 0;
                            }
                            @foreach (var item in StaffNavigatorFormat.LedgerItems)
                            {
                                var cls = (item.Group != previousGroup && previousGroup != 0 ? "group-start " : "") + (item.Strong ? "fw-bold table-light" : "");
                                previousGroup = item.Group;
                                <tr class="@cls">
                                    <th class="fw-normal @(item.Strong ? "fw-bold" : "")">@item.Label</th>
                                    @foreach (var m in months)
                                    {
                                        <td class="num">@(byMonth.TryGetValue(m, out var col) ? StaffNavigatorFormat.FormatValue(item, item.Value(col.Staff!)) : "")</td>
                                    }
                                    <td class="num fw-bold">@(staffMonths.Count > 0 ? StaffNavigatorFormat.FormatValue(item, StaffNavigatorFormat.Total(item, staffMonths)) : "")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="note-box mt-3">
                    @Icons.Svg("help", 18)
                    <div>項目と並び順は、スタッフナビゲーターの「給与管理｜賃金台帳印刷」に合わせています。CSV出力もスタッフナビゲーターの「賃金台帳CSVファイル出力形式」と同じ項目です。締日は末日、支払日は翌月@(Model.Columns.FirstOrDefault().View?.Settings.PayDayOfMonth ?? 25)日として表示しています。</div>
                </div>
                <div class="note-box warn mt-2">
                    @Icons.Svg("alert", 18)
                    <div>金額はデモ用の簡易計算です（社会保険料は総支給額×料率、所得税は簡易税率で算出）。本開発では、スタッフナビゲーターの給与計算結果（賃金台帳CSV）を取り込んで使う方式を想定しています。</div>
                </div>
            </div>
        }
    </div>
</div>
