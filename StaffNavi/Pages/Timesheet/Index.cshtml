@page
@model StaffNavi.Pages.Timesheet.IndexModel
@{
    ViewData["Title"] = "勤務表";
    ViewData["Nav"] = "timesheet";
    var view = Model.View;
    var current = Model.Current;
    string H(int minutes) => Fmt.HoursOrBlank(minutes);
}

<div class="page-head">
    <div>
        <h1 class="page-title">勤務表</h1>
        <div class="page-sub">タイムシート（原本）に補正内容を反映した勤務実績です。スタッフナビゲーターの勤務表（実績）と同じく、受注ごとに作成します</div>
    </div>
    @if (view != null)
    {
        <div class="d-flex gap-2 flex-wrap">
            <a class="btn btn-outline-secondary" asp-page-handler="Csv" asp-route-month="@view.Month" asp-route-site="@Model.Site">@Icons.Svg("download", 16) Excel出力（CSV）</a>
            @if (current != null)
            {
                <a class="btn btn-primary" asp-page="/Output/Print" asp-route-type="timesheet" asp-route-month="@view.Month" asp-route-emp="@current.Staff.EmployeeNo" target="_blank">@Icons.Svg("printer", 16) 提出用PDF</a>
            }
        </div>
    }
</div>

@if (view == null)
{
    <div class="panel">
        <p class="mb-3">タイムシートがまだ取り込まれていません。</p>
        <a class="btn btn-primary" asp-page="/Import/Index">@Icons.Svg("upload", 16) CSV取込へ</a>
    </div>
    return;
}

<div class="row g-3">
    <div class="col-lg-3">
        <div class="panel">
            <form method="get" class="mb-3">
                <label class="form-label small text-muted mb-1">就業月</label>
                <select class="form-select mb-2" name="month" onchange="this.form.submit()">
                    @foreach (var m in Model.Months)
                    {
                        <option value="@m" selected="@(m == view.Month)">@Fmt.Month(m)</option>
                    }
                </select>
                <label class="form-label small text-muted mb-1">就業先（SS）</label>
                <select class="form-select mb-2" name="site" onchange="this.form.submit()">
                    <option value="">すべての就業先</option>
                    @foreach (var s in Model.Sites)
                    {
                        <option value="@s" selected="@(s == Model.Site)">@s</option>
                    }
                </select>
                <select class="form-select mb-2" name="filter" onchange="this.form.submit()">
                    <option value="">すべてのスタッフ（@view.Staff.Count 名）</option>
                    <option value="alert" selected="@(Model.Filter == "alert")">要確認ありのみ</option>
                    <option value="multi" selected="@(Model.Filter == "multi")">掛け持ち（複数の受注）のみ</option>
                </select>
                <input class="form-control" type="search" name="q" value="@Model.Q" placeholder="氏名・スタッフ番号・SSで絞込" />
            </form>
            <div class="staff-list">
                @foreach (var s in Model.StaffList)
                {
                    <a class="staff-item @(s == current ? "active" : "")" asp-route-month="@view.Month" asp-route-site="@Model.Site" asp-route-q="@Model.Q" asp-route-filter="@Model.Filter" asp-route-emp="@s.Staff.EmployeeNo">
                        <span>
                            <span class="name d-block">@s.Staff.Name</span>
                            <span class="meta">@s.Staff.EmployeeNo・@string.Join("／", s.Workplaces)・@Fmt.Hours(s.Summary.TotalMinutes)</span>
                        </span>
                        <span class="text-end">
                            @if (s.Sheets.Count > 1)
                            {
                                <span class="pill pill-blue" title="複数の受注で勤務">掛持@(s.Sheets.Count)</span>
                            }
                            @if (s.Summary.WarningCount > 0)
                            {
                                <span class="pill pill-red" title="要確認">@s.Summary.WarningCount</span>
                            }
                            @if (s.Summary.CorrectionCount > 0)
                            {
                                <span class="pill pill-orange" title="補正">補正@(s.Summary.CorrectionCount)</span>
                            }
                        </span>
                    </a>
                }
                @if (Model.StaffList.Count == 0)
                {
                    <p class="text-muted small px-2">該当するスタッフがいません。</p>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-9">
        @if (current == null)
        {
            <div class="panel text-muted">スタッフを選択してください。</div>
        }
        else
        {
            var sum = current.Summary;
            <div class="panel">
                <div class="d-flex justify-content-between flex-wrap gap-2 mb-3">
                    <div>
                        <div class="h5 fw-bold mb-1">@current.Staff.Name <small class="text-muted fw-normal">（@current.Staff.EmployeeNo.PadLeft(8, '0')）</small></div>
                        <div class="text-muted small">
                            @current.Staff.Category ／ @current.Staff.EmploymentForm ／ @Fmt.Month(view.Month)（@view.FirstDay.ToString("yyyy/MM/dd") ～ @view.LastDay.ToString("yyyy/MM/dd")）
                            @if (current.Staff.Retired)
                            {
                                <span class="pill pill-gray ms-1">退職 @current.Staff.RetireDate?.ToString("yyyy/MM/dd")</span>
                            }
                        </div>
                    </div>
                    <div class="small text-muted text-end">
                        @foreach (var sheet in current.Sheets)
                        {
                            <div>@sheet.Order.OrderNo：<a asp-page="/Import/Detail" asp-route-id="@sheet.BatchId">@sheet.FileName</a>（@Fmt.DateTime(sheet.ImportedAt)）</div>
                        }
                    </div>
                </div>
                @if (current.Sheets.Count > 1)
                {
                    <div class="note-box mb-3">
                        @Icons.Svg("users", 18)
                        <div><strong>掛け持ち：</strong>@current.Sheets.Count 件の受注（@string.Join("、", current.Sheets.Select(x => x.Order.Name))）で勤務しています。勤務表は受注ごとに作成し、下の集計は全受注の合計です（出勤日数は同じ日を1日と数えます）。</div>
                    </div>
                }
                <div class="stat-chips">
                    <div class="stat-chip"><span class="label">出勤日数</span><span class="value">@sum.WorkDays 日</span></div>
                    <div class="stat-chip"><span class="label">有給日数</span><span class="value">@Fmt.Days(sum.PaidLeaveDays) 日</span></div>
                    <div class="stat-chip"><span class="label">欠勤日数</span><span class="value">@sum.AbsenceDays 日</span></div>
                    <div class="stat-chip"><span class="label">基本</span><span class="value">@Fmt.Hours(sum.BasicMinutes)</span></div>
                    <div class="stat-chip"><span class="label">普通残</span><span class="value">@Fmt.Hours(sum.OvertimeMinutes)</span></div>
                    <div class="stat-chip"><span class="label">深夜</span><span class="value">@Fmt.Hours(sum.NightMinutes)</span></div>
                    <div class="stat-chip"><span class="label">深夜残</span><span class="value">@Fmt.Hours(sum.NightOvertimeMinutes)</span></div>
                    <div class="stat-chip"><span class="label">休出</span><span class="value">@Fmt.Hours(sum.HolidayMinutes)</span></div>
                    <div class="stat-chip"><span class="label">合計</span><span class="value">@Fmt.Hours(sum.TotalMinutes)</span></div>
                    <div class="stat-chip"><span class="label">時間外（月）</span><span class="value @(sum.TotalOvertimeMinutes > 45 * 60 ? "text-danger" : "")">@Fmt.Hours(sum.TotalOvertimeMinutes)</span></div>
                    <div class="stat-chip"><span class="label">要確認</span><span class="value @(sum.WarningCount > 0 ? "text-danger" : "")">@sum.WarningCount 件</span></div>
                    <div class="stat-chip"><span class="label">補正</span><span class="value">@sum.CorrectionCount 件</span></div>
                </div>
            </div>

            foreach (var sheet in current.Sheets)
            {
                var o = sheet.Order;
                var ss = sheet.Summary;
                <div class="panel" id="o@(o.OrderNo)">
                    <div class="panel-title">
                        <h2>タイムシート（給与） @(view.FirstDay.Month)月度分　<span class="text-muted fw-normal">@o.Name（@o.OrderNo）</span></h2>
                    </div>
                    <table class="table table-sm sheet-head mb-3">
                        <tr><th>請負先</th><td>@o.Client</td><th>就業先</th><td>@o.Workplace</td></tr>
                        <tr><th>受注名称</th><td>@o.Name（@o.OrderNo）</td><th>所在地</th><td>@o.Address</td></tr>
                        <tr><th>業務内容</th><td>@o.JobDescription（@o.Area）／ @o.ShiftName</td><th>勤務帯・所定</th><td>@o.ShiftLabel ／ 所定 @Fmt.Hours(o.StandardMinutes)　単価 @Fmt.Yen(o.HourlyWage)円</td></tr>
                    </table>
                    <div class="table-wrap">
                        <table class="table table-app table-sm timesheet-table">
                            <thead>
                                <tr>
                                    <th></th><th>日付</th><th>曜日</th><th>所定</th><th>区分</th><th>出欠</th><th>始業</th><th>終業</th>
                                    <th class="num">休憩時</th><th class="num">有給時</th><th class="num">基本</th><th class="num">普通残</th><th class="num">深夜</th><th class="num">深夜残</th><th class="num">休出</th><th class="num">合計</th>
                                    <th>状態</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var d in sheet.Days)
                                {
                                    var e = d.HasData ? d.Effective : null;
                                    var orig = d.Original?.Values;
                                    var corrected = d.IsCorrected;
                                    var rowClass = (d.Date.DayOfWeek == DayOfWeek.Saturday ? "day-sat " : d.Date.DayOfWeek == DayOfWeek.Sunday ? "day-sun " : "")
                                        + (corrected ? "row-corrected" : d.Warnings.Count > 0 ? "row-warning" : e == null ? "row-empty" : "");
                                    var kindNow = e?.Kind.Label() ?? "";
                                    var kindWas = orig?.Kind.Label() ?? "なし";
                                    var startNow = Fmt.Clock(e?.Start); var startWas = Fmt.Clock(orig?.Start);
                                    var endNow = Fmt.Clock(e?.End); var endWas = Fmt.Clock(orig?.End);
                                    var hasTimes = e?.Kind.HasTimes() == true;
                                    var breakNow = d.Calc.WorkMinutes > 0 ? H(e!.BreakMinutes) : "";
                                    var breakWas = orig?.Kind.HasTimes() == true && orig.Start != null && orig.End != null ? H(orig.BreakMinutes) : "";
                                    <tr id="o@(o.OrderNo)-d@(d.Date.Day)" class="@rowClass">
                                        <td class="text-nowrap">
                                            <button type="button" class="btn btn-sm @(d.Warnings.Count > 0 ? "btn-primary" : e == null ? "btn-link text-muted p-0" : "btn-outline-secondary")"
                                                    data-bs-toggle="modal" data-bs-target="#correctModal"
                                                    data-order="@o.OrderNo" data-order-name="@o.Name" data-date="@d.Date.ToString("yyyy-MM-dd")" data-label="@Fmt.Day(d.Date)"
                                                    data-kind="@(e?.Kind ?? DayKind.Work)" data-start="@(startNow == "" && e == null ? Fmt.Clock(o.ShiftStart) : startNow)"
                                                    data-end="@(endNow == "" && e == null ? Fmt.Clock(o.ShiftEnd) : endNow)"
                                                    data-break="@(e?.Kind.HasTimes() == true ? e.BreakMinutes : 60)"
                                                    data-current="@(e?.Describe() ?? "データなし")" data-original="@(orig?.Describe() ?? "データなし")">
                                                @Icons.Svg("edit", 14) @(e == null ? "追加" : "補正")
                                            </button>
                                        </td>
                                        <td class="text-nowrap">@d.Date.ToString("MM/dd")</td>
                                        <td>@Fmt.Weekday(d.Date)</td>
                                        <td class="text-muted">@d.Calendar</td>
                                        <td class="text-nowrap">@(e != null ? o.ShiftLabel : "")</td>
                                        <td>@kindNow @if (corrected && kindWas != kindNow) { <span class="was">@kindWas</span> }</td>
                                        <td>@startNow @if (corrected && startWas != startNow) { <span class="was">@(startWas == "" ? "未入力" : startWas)</span> }</td>
                                        <td>@(hasTimes && e!.End == null ? "" : endNow) @if (corrected && endWas != endNow) { <span class="was">@(endWas == "" ? "未入力" : endWas)</span> }</td>
                                        <td class="num">@breakNow @if (corrected && breakWas != breakNow && breakWas != "") { <span class="was">@breakWas</span> }</td>
                                        <td class="num">@H(d.Calc.PaidLeaveMinutes)</td>
                                        <td class="num">@H(d.Calc.BasicMinutes)</td>
                                        <td class="num">@H(d.Calc.OvertimeMinutes)</td>
                                        <td class="num">@H(d.Calc.NightMinutes)</td>
                                        <td class="num">@H(d.Calc.NightOvertimeMinutes)</td>
                                        <td class="num">@H(d.Calc.HolidayMinutes)</td>
                                        <td class="num fw-bold">@H(d.Calc.TotalMinutes)</td>
                                        <td>
                                            @foreach (var w in d.Warnings)
                                            {
                                                <span class="pill pill-red d-inline-block mb-1">@Icons.Svg("alert", 12) @w</span>
                                            }
                                            @if (corrected)
                                            {
                                                <span class="pill pill-orange" title="@d.Correction!.Reason（@d.Correction.CorrectedBy @Fmt.DateTime(d.Correction.CorrectedAt)）">@Icons.Svg("history", 12) 補正済み</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr class="fw-bold">
                                    <td></td>
                                    <td colspan="4">合計</td>
                                    <td>@(ss.WorkDays + ss.HolidayWorkDays)日</td>
                                    <td></td><td></td>
                                    <td class="num">@H(ss.BreakMinutes)</td>
                                    <td class="num">@H(ss.PaidLeaveMinutes)</td>
                                    <td class="num">@H(ss.BasicMinutes)</td>
                                    <td class="num">@H(ss.OvertimeMinutes)</td>
                                    <td class="num">@H(ss.NightMinutes)</td>
                                    <td class="num">@H(ss.NightOvertimeMinutes)</td>
                                    <td class="num">@H(ss.HolidayMinutes)</td>
                                    <td class="num">@H(ss.TotalMinutes)</td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            }
            <div class="small text-muted mb-3">
                黄色の行は補正済み、取消線は取込時（原本）の値です。時刻はスタッフナビゲーターと同じく、日をまたぐ場合 24:00 以降（例：翌朝8時＝32:00）で表します。
                時間区分は先方の勤務表（実績）と同じ考え方で計算しています（深夜＝22時～翌5時。休憩は深夜帯から差し引き、受注の所定時間を超えた分を普通残・深夜残とする）。
            </div>

            <div class="panel">
                <div class="panel-title">
                    <h2>この月の補正履歴</h2>
                    <a class="more" asp-page="/Corrections/Index" asp-route-month="@view.Month" asp-route-emp="@current.Staff.EmployeeNo">補正履歴画面で見る →</a>
                </div>
                @if (Model.CurrentCorrections.Count == 0)
                {
                    <p class="text-muted mb-0">補正履歴はありません。</p>
                }
                else
                {
                    <div class="table-wrap">
                        <table class="table table-app">
                            <thead><tr><th>補正日時</th><th>就業日</th><th>受注</th><th>補正前</th><th>補正後</th><th>補正理由</th><th>補正者</th><th>状態</th></tr></thead>
                            <tbody>
                                @foreach (var c in Model.CurrentCorrections)
                                {
                                    <tr class="@(c.Revoked ? "text-muted" : "")">
                                        <td class="text-nowrap">@Fmt.DateTime(c.CorrectedAt)</td>
                                        <td class="text-nowrap">@Fmt.Day(c.Date)</td>
                                        <td class="small">@c.OrderName</td>
                                        <td class="small">@(c.Before?.Describe() ?? "データなし")</td>
                                        <td class="small">@c.After.Describe()</td>
                                        <td class="small">@c.Reason @if (c.Evidence != null) { <div class="text-muted">根拠：@c.Evidence</div> }</td>
                                        <td>@c.CorrectedBy</td>
                                        <td>@if (c.Revoked) { <span class="pill pill-gray" title="@c.RevokeReason">取消済み</span> } else { <span class="pill pill-green">有効</span> }</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }
    </div>
</div>

@if (current != null)
{
    <div class="modal fade" id="correctModal" tabindex="-1" aria-labelledby="correctModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <form class="modal-content" method="post" asp-page-handler="Correct">
                <input type="hidden" name="month" value="@view.Month" />
                <input type="hidden" name="emp" value="@current.Staff.EmployeeNo" />
                @* 補正後も表示条件（就業先・絞込・検索）を保持する *@
                <input type="hidden" name="site" value="@Model.Site" />
                <input type="hidden" name="filter" value="@Model.Filter" />
                <input type="hidden" name="q" value="@Model.Q" />
                <input type="hidden" name="order" />
                <input type="hidden" name="date" />
                <div class="modal-header">
                    <h2 class="modal-title h5" id="correctModalLabel">勤務データの補正 <small class="text-muted" data-field="label"></small></h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="閉じる"></button>
                </div>
                <div class="modal-body">
                    <table class="table table-sm diff-table mb-3">
                        <tr><th class="text-muted fw-normal" style="width: 140px">受注</th><td data-field="orderName"></td></tr>
                        <tr><th class="text-muted fw-normal">取込時（原本）</th><td data-field="original"></td></tr>
                        <tr><th class="text-muted fw-normal">現在の内容</th><td data-field="current"></td></tr>
                    </table>
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label class="form-label">出欠</label>
                            <select class="form-select" name="kind">
                                @foreach (var k in DayKindExtensions.Selectable)
                                {
                                    <option value="@k">@k.Label()</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3 time-field">
                            <label class="form-label">始業</label>
                            <input class="form-control" name="start" placeholder="22:00" pattern="\d{1,2}:\d{2}" inputmode="numeric" />
                        </div>
                        <div class="col-md-3 time-field">
                            <label class="form-label">終業</label>
                            <input class="form-control" name="end" placeholder="32:00" pattern="\d{1,2}:\d{2}" inputmode="numeric" />
                        </div>
                        <div class="col-md-3 time-field">
                            <label class="form-label">休憩（分）</label>
                            <input class="form-control" type="number" name="breakMinutes" min="0" max="600" step="5" />
                        </div>
                        <div class="col-12 time-field">
                            <div class="form-text mt-0">日をまたぐ終業は 24:00 以降で入力します（例：22:00～翌8:00 → 終業 32:00）。8:00 と入力しても翌日として扱います。</div>
                        </div>
                        <div class="col-12">
                            <label class="form-label">補正理由 <span class="text-danger">*</span></label>
                            <textarea class="form-control" name="reason" rows="2" required placeholder="例：終業の打刻漏れ。店舗日報および本人申告により終業時刻を確認"></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label">根拠資料</label>
                            <input class="form-control" name="evidence" placeholder="例：店舗日報（10/21）、本人申告書" />
                        </div>
                    </div>
                    <div class="note-box mt-3">
                        @Icons.Svg("shield", 18)
                        <div>補正しても取込データ（原本）は変更されません。補正前・補正後・理由・補正者・日時が履歴として記録されます。スタッフナビゲーターの正データにも自動では反映されません（必要な場合は「提出資料出力」から勤怠データCSVを出力して取り込みます）。</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">キャンセル</button>
                    <button type="submit" class="btn btn-primary px-4">@Icons.Svg("check", 16) 補正を登録</button>
                </div>
            </form>
        </div>
    </div>
}

@section Scripts {
    <script>
        (function () {
            var modal = document.getElementById('correctModal');
            if (!modal) return;
            var form = modal.querySelector('form');
            var timeKinds = ['Work', 'HolidayWork', 'HalfPaidLeave'];
            function toggleTimes() {
                var working = timeKinds.indexOf(form.kind.value) >= 0;
                modal.querySelectorAll('.time-field').forEach(function (el) { el.style.display = working ? '' : 'none'; });
            }
            modal.addEventListener('show.bs.modal', function (e) {
                var b = e.relatedTarget.dataset;
                form.order.value = b.order;
                form.date.value = b.date;
                form.kind.value = b.kind;
                form.start.value = b.start;
                form.end.value = b.end;
                form.breakMinutes.value = b.break;
                form.reason.value = '';
                form.evidence.value = '';
                modal.querySelector('[data-field=label]').textContent = b.label;
                modal.querySelector('[data-field=orderName]').textContent = b.orderName + '（' + b.order + '）';
                modal.querySelector('[data-field=current]').textContent = b.current;
                modal.querySelector('[data-field=original]').textContent = b.original;
                toggleTimes();
            });
            form.kind.addEventListener('change', toggleTimes);
        })();
    </script>
}
